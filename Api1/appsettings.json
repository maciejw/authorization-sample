{
  "Authentication": {
    "Schemes": {
      "Bearer": {
        "Authority": "https://your-issuer"
      },
      "ServiceBearer": {
        "Authority": "https://your-service-issuer"
      },
      "InfrastructureBearer": {
        "Authority": "https://your-service-issuer"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "HttpClients": {
    "Opa": {
      "BaseAddress": "http://127.0.0.1:8181/",
      "SigningKey": "sample-only-opa-signing-key-at-least-32-bytes"
    }
  }
}
